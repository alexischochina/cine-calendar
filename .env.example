# Copier en `.env` et remplir. Aucune valeur réelle ici.
# Le `.gitignore` ignore `.env` et garde ce fichier-ci (`!.env.example`).

# --- Application (lues par Nuxt) ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

TMD_TOKEN=                  # TMDB bearer token
NUXT_API_KEY=               # TMDB API key
NUXT_API_BASE_URL=          # ex. https://api.themoviedb.org/3
NUXT_API_IMG_URL=           # ex. https://image.tmdb.org/t/p

# URL publique du site. Déjà lue par `app/app.vue` pour les balises Open Graph, et désormais par
# `/mot-de-passe-oublie` : c'est elle qui compose le lien de réinitialisation renvoyé par Supabase.
#
# ⚠️ Vide en local, `useRequestURL().origin` prend le relais — mais **en production elle doit être
# renseignée**, sinon le lien du mail pointe vers l'origine du rendu et non vers le site.
# ⚠️ L'URL `<site>/nouveau-mot-de-passe` doit aussi figurer dans les *Redirect URLs* du dashboard
# Supabase (Authentication → URL Configuration), sans quoi le lien retombe sur le *Site URL*.
NUXT_PUBLIC_SITE_URL=

# Secret partagé avec la tâche planifiée de préchauffage des séances
# (`server/api/cron/warm.js` ↔ `.github/workflows/warm-showtimes.yml`, secret `CRON_SECRET`).
#
# ⚠️ À poser aussi sur l'hébergement, sinon le préchauffage ne tourne pas. Vide = route éteinte
# (503), jamais ouverte : elle sort sur le réseau et n'a pas de session sur laquelle s'appuyer.
# Générer avec `openssl rand -hex 24`.
NUXT_CRON_SECRET=

# --- Application ET scripts ---------------------------------------------------------------------

# Clé service-role : contourne RLS, indispensable pour écrire hors session utilisateur. Replis
# acceptés dans cet ordre : SUPABASE_SERVICE_KEY, puis SUPABASE_KEY.
#
# ⚠️ Plus « scripts uniquement » depuis le préchauffage : `server/api/cron/warm.js` en a besoin, une
# tâche planifiée n'ayant pas de session — et les politiques RLS de `showtimes_cache` comme de
# `cinemas` sont réservées à `authenticated`. Elle doit donc exister sur l'hébergement, pas
# seulement en local.
NUXT_SUPABASE_SECRET_KEY=

# --- Scripts uniquement (`scripts/`, jamais lues par Nuxt) --------------------------------------

# Île-de-France Mobilités — jeton gratuit sur https://prim.iledefrance-mobilites.fr
# Utilisé par `scripts/transit-times.mjs` pour pré-calculer `cinemas.transit_minutes`.
PRIM_TOKEN=

# Domicile, origine des temps de trajet.
#
# ⚠️ Surtout PAS `NUXT_PUBLIC_HOME_LAT` / `NUXT_PUBLIC_HOME_LNG`, leurs anciens noms : le préfixe
# `NUXT_PUBLIC_` est ce qui expose une variable au navigateur dès qu'une clé correspondante existe
# dans `runtimeConfig.public`. Ces coordonnées sont une donnée personnelle et ne quittent jamais le
# serveur — c'est pourquoi le temps de trajet est pré-calculé côté script plutôt que dans l'app
# (cf. `app/utils/travel.js`).
HOME_LAT=
HOME_LNG=
